{
  "name": "@decomm/ident",
  "version": "1.0.0",
  "license": "MIT",
  "exports": {
    ".": "./main.ts",
    "./init": "./init.ts"
  },
  "publish": {
    "include": [
      "main.ts",
      "args.ts",
      "hash.ts",
      "store.ts",
      "init.ts",
      "ident.sh",
      "README.md",
      "LICENSE",
      "deno.json",
      "jsr.json"
    ]
  },
  "tasks": {
    "ident": "deno run --allow-read --allow-write --allow-env=IDENT_DIR main.ts",
    "compile": "mkdir -p bin && deno compile --allow-read --allow-write --allow-env=IDENT_DIR --output bin/ident main.ts",
    "test": "deno test --allow-read --allow-write --allow-net --allow-env --allow-run",
    "check": "deno check main.ts args.ts hash.ts store.ts init.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@decomm/avatar/render": "jsr:@decomm/avatar@^1.0.1/render"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  }
}
